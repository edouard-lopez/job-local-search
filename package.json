{
  "name": "job-local-search",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite",
    "build:data": "python3 scripts/build.py",
    "prebuild": "npm run generate",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "generate": "npm run changelog && npm run offers-date",
    "changelog": "node scripts/changelog.mjs",
    "offers-date": "node scripts/offers-date.mjs",
    "test:e2e": "playwright test --trace off",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.11",
    "autoprefixer": "10.7.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "banana-i18n": "2.4.0",
    "leaflet": "1.9.4",
    "pinia": "4.1.0",
    "trystero": "^0.27.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "yjs": "^13.6.33"
  }
}
